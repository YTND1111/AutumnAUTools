# 本地开发环境变量模板：复制为 .dev.vars 后修改（.dev.vars 已被 .gitignore 忽略）
#
# 本地开发时 wrangler dev 会读取本文件；生产环境用：
#   wrangler secret put AUTH_PEPPER
#   wrangler secret put ALLOWED_ORIGINS   # 或写在 wrangler.toml 的 [vars] 里

# 密码「胡椒」：与数据库中的哈希混合使用，即使 D1 数据泄露也无法离线爆破。
# ⚠️ 一旦设置后不可随意更改，否则所有用户密码将无法校验。
AUTH_PEPPER = "dev-only-change-me"

# 允许的来源（逗号分隔）
ALLOWED_ORIGINS = "http://localhost:3000,http://127.0.0.1:3000"

# 本地调试可降低迭代次数，加快注册/登录
PBKDF2_ITERATIONS = "100000"

ALLOW_REGISTRATION = "true"
SESSION_TTL_DAYS = "30"
