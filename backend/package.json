{
  "name": "autumn-autools-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "秋功（AutumnAUTools）用户后端 —— Cloudflare Workers + D1 + Web Crypto，零运行时依赖",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/smoke-test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply autumn-autools --local",
    "db:migrate:remote": "wrangler d1 migrations apply autumn-autools --remote",
    "db:console:local": "wrangler d1 execute autumn-autools --local --command \"SELECT id, username, created_at FROM users\"",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "wrangler": "^4.42.0"
  }
}
